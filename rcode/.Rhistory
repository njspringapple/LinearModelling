hr(), h4("\U0001F4E6 成交量因子"),
checkboxInput("volume_factor", "启用成交量因子", FALSE),
conditionalPanel("input.volume_factor == true",
sliderInput("volume_sensitivity", "敏感度:", 0, 5, 2, 0.5)),
hr(), h4("\U0001F4B0 回测参数"),
numericInput("initial_capital", "初始本金:", 500000, 50000, 10000000, 50000),
numericInput("trade_amount",    "每次交易金额:", 100000, 10000, 1000000, 10000),
sliderInput("max_positions", "单板块最大持仓次数:", 1, 10, 3, 1),
checkboxInput("sell_all", "卖出时全仓清仓", FALSE),
helpText("空闲资金自动持有中证银行，转换无手续费"),
hr(),
actionButton("refresh", "\U0001F504 刷新数据", class = "btn-primary", width = "100%")
),
mainPanel(
width = 9,
uiOutput("alert_panel"),
tabsetPanel(type = "tabs",
tabPanel("\U0001F4CA 相对强弱",
fluidRow(
column(4, selectInput("kline_sector", "K线板块:",
choices = sapply(OBSERVE_ETFS, function(x) x$name), selected = "中证有色"))
),
plotlyOutput("trend_plot", height = "450px"),
plotlyOutput("volume_plot", height = "150px"),
hr(),
fluidRow(
column(6, h4("最新状态"), tableOutput("signal_table")),
column(6, h4("信号统计"), tableOutput("signal_stats")))
),
tabPanel("\U0001F3C6 板块排名",
h4("全部板块相对强弱排名"),
plotlyOutput("ranking_chart", height = "350px"),
hr(), tableOutput("ranking_table")
),
tabPanel("\u2693 锚定组合",
plotlyOutput("anchor_chart", height = "400px"),
hr(), h4("锚定成分表现"), tableOutput("anchor_stats_table")
),
tabPanel("\U0001F4C8 回测净值",
plotlyOutput("nav_plot", height = "450px"),
hr(),
h4("全局统计"), tableOutput("global_stats_table"),
h4("分板块统计"), tableOutput("sector_stats_table"),
conditionalPanel("true",
h4("跳过的买入信号（银行持仓不足/持仓已满）"),
DT::dataTableOutput("skip_table"))
),
tabPanel("\U0001F4CB 交易记录",
selectInput("trade_sector", "板块:",
choices = sapply(OBSERVE_ETFS, function(x) x$name), selected = "中证有色"),
h4("交易明细"), DT::dataTableOutput("trade_table"),
hr(), h4("配对盈亏 (FIFO)"), DT::dataTableOutput("matched_table")
),
tabPanel("\U0001F527 数据诊断",
h4("各板块数据概况"), tableOutput("diag_table"),
hr(), h4("价格走势（归一化）"), plotlyOutput("price_plot", height = "400px")
)
)
)
)
)
# ============================================================
# Server
# ============================================================
server <- function(input, output, session) {
data_store <- reactiveValues(anchor_data = NULL, observe_data = NULL, loaded = FALSE)
observe({
if (!data_store$loaded) {
withProgress(message = "正在加载数据...", {
data_store$anchor_data  <- load_etf_data(ANCHOR_ETFS, DATA_DIR)
incProgress(0.5)
data_store$observe_data <- load_etf_data(OBSERVE_ETFS, DATA_DIR)
incProgress(0.5)
data_store$loaded <- TRUE
})
if (length(data_store$observe_data) > 0) {
all_dates <- do.call(c, lapply(data_store$observe_data, function(x) x$date))
updateDateRangeInput(session, "date_range",
start = min(all_dates), end = max(all_dates),
min = min(all_dates), max = max(all_dates))
loaded_sectors <- names(data_store$observe_data)
updateCheckboxGroupInput(session, "sectors",
choices = loaded_sectors, selected = loaded_sectors[1])
}
}
})
observeEvent(input$refresh, { data_store$loaded <- FALSE })
observe({
req(input$sectors)
cs <- input$kline_sector
if (is.null(cs) || !cs %in% input$sectors) cs <- input$sectors[1]
updateSelectInput(session, "kline_sector", choices = input$sectors, selected = cs)
cs2 <- input$trade_sector
if (is.null(cs2) || !cs2 %in% input$sectors) cs2 <- input$sectors[1]
updateSelectInput(session, "trade_sector", choices = input$sectors, selected = cs2)
})
anchor_weights <- reactive({
w <- c(input$w_bank, input$w_dividend, input$w_high_div)
s <- sum(w)
if (s == 0) rep(1/3, 3) else w / s
})
relative_data <- reactive({
req(data_store$anchor_data, data_store$observe_data)
ar <- calc_anchor_return(data_store$anchor_data, input$period, anchor_weights())
calc_relative_return(data_store$observe_data, ar, input$period)
})
processed_data <- reactive({
req(relative_data())
data <- relative_data() %>%
filter(date >= input$date_range[1], date <= input$date_range[2])
if (nrow(data) == 0) return(data)
if (input$volume_factor && "volume" %in% names(data)) {
sens <- input$volume_sensitivity
data <- data %>% group_by(name) %>%
mutate(
vol_mean = mean(volume, na.rm = TRUE),
vol_ratio = ifelse(vol_mean > 0, volume / vol_mean, 1),
pct_w = pct_change * (1 + (vol_ratio - 1) * sens),
anc_w = anchor_return * (1 + (vol_ratio - 1) * sens)
) %>% ungroup()
} else {
data <- data %>% mutate(vol_ratio = 1, pct_w = pct_change, anc_w = anchor_return)
}
if (input$relative_mode == "cumulative") {
data <- data %>% group_by(name) %>%
mutate(
obs_cum = cumprod(1 + pct_w / 100) - 1,
anc_cum = cumprod(1 + anc_w / 100) - 1,
rel_val = (obs_cum - anc_cum) * 100
) %>% ungroup()
if (input$smooth_n > 1) {
data <- data %>% group_by(name) %>%
mutate(relative_return_smooth = rollmean(rel_val, k = input$smooth_n, fill = NA, align = "right")) %>%
ungroup() %>% filter(!is.na(relative_return_smooth))
} else {
data$relative_return_smooth <- data$rel_val
}
} else {
data <- data %>% arrange(name, date) %>% group_by(name) %>%
mutate(
r_obs = rollapplyr(pct_w, input$rolling_window,
function(x) (prod(1 + x/100) - 1) * 100, fill = NA),
r_anc = rollapplyr(anc_w, input$rolling_window,
function(x) (prod(1 + x/100) - 1) * 100, fill = NA),
rel_val = r_obs - r_anc
) %>% ungroup()
if (input$smooth_n > 1) {
data <- data %>% group_by(name) %>%
mutate(relative_return_smooth = rollmean(rel_val, k = input$smooth_n, fill = NA, align = "right")) %>%
ungroup() %>% filter(!is.na(relative_return_smooth))
} else {
data$relative_return_smooth <- data$rel_val
data <- data %>% filter(!is.na(relative_return_smooth))
}
}
data
})
signal_data <- reactive({
req(processed_data())
d <- processed_data()
if (nrow(d) == 0) return(d)
identify_signals(d,
buy_threshold = input$buy_threshold, sell_threshold = input$sell_threshold,
confirm_days = input$confirm_days, filter_by_daily = input$filter_by_daily,
cooldown = input$cooldown, threshold_mode = input$threshold_mode,
buy_pct = input$buy_pct, sell_pct = input$sell_pct)
})
# ★ 修改: 传入中证银行价格数据（不筛选日期范围，让回测函数自己对齐）
backtest_results <- reactive({
req(signal_data(), data_store$anchor_data)
sel <- signal_data() %>% filter(name %in% input$sectors)
if (nrow(sel) == 0) return(list())
bank_raw <- data_store$anchor_data[["中证银行"]]
if (is.null(bank_raw) || nrow(bank_raw) == 0) return(list())
bank_agg <- aggregate_to_period(bank_raw, input$period)
# ★ 不做日期筛选，把全部银行价格传入，让回测函数内部na.locf处理对齐
bank_prices <- bank_agg %>% select(date, close)
run_backtest(sel,
bank_prices = bank_prices,
initial_capital = input$initial_capital,
trade_amount = input$trade_amount,
max_positions = input$max_positions,
sell_all = input$sell_all)
})
# ===========================================================
# 信号提醒
# ===========================================================
output$alert_panel <- renderUI({
req(signal_data())
d <- signal_data()
if (nrow(d) == 0) return(NULL)
max_date <- max(d$date)
recent <- d %>%
filter(buy_signal | sell_signal, date >= max_date - 10) %>%
arrange(desc(date)) %>% head(12)
if (nrow(recent) == 0) return(NULL)
alerts <- recent %>% mutate(txt = paste0(
as.character(date), " | ", name, " | ",
ifelse(buy_signal, "\U0001F535 买入信号(银行->板块)", "\U0001F534 卖出信号(板块->银行)"),
" | 相对强弱: ", round(relative_return_smooth, 2), "%",
" | 价格: ", round(close, 2)))
wellPanel(
style = "background-color:#FFF3CD; border:1px solid #FFC107; max-height:120px; overflow-y:auto;",
h5("\u26A1 最近信号提醒"),
tags$div(style = "font-size:13px;",
lapply(alerts$txt, function(t) tags$div(t))))
})
# ===========================================================
# 相对强弱 + K线
# ===========================================================
output$trend_plot <- renderPlotly({
req(signal_data())
data <- signal_data() %>% filter(name %in% input$sectors)
if (nrow(data) == 0) return(plotly_empty())
kline_sector <- input$kline_sector
sectors <- unique(data$name)
if (input$threshold_mode == "fixed") {
buy_th <- input$buy_threshold; sell_th <- input$sell_threshold
} else {
buy_th <- median(data$buy_threshold_val, na.rm = TRUE)
sell_th <- median(data$sell_threshold_val, na.rm = TRUE)
}
p <- plot_ly()
dr <- range(data$date)
p <- p %>%
add_trace(x=dr, y=c(buy_th,buy_th), type="scatter", mode="lines",
name=paste0("买入阈值(",round(buy_th,1),"%)"),
line=list(color="#4ECDC4",width=1.5,dash="dot"), hoverinfo="skip") %>%
add_trace(x=dr, y=c(sell_th,sell_th), type="scatter", mode="lines",
name=paste0("卖出阈值(",round(sell_th,1),"%)"),
line=list(color="#FF6B6B",width=1.5,dash="dot"), hoverinfo="skip") %>%
add_trace(x=dr, y=c(0,0), type="scatter", mode="lines",
line=list(color="rgba(128,128,128,0.4)",width=1,dash="dash"),
showlegend=FALSE, hoverinfo="skip")
for (s in sectors) {
sd <- data %>% filter(name == s)
clr <- SECTOR_COLORS[s]
p <- p %>% add_trace(data=sd, x=~date, y=~relative_return_smooth,
type="scatter", mode="lines", name=s, legendgroup=s,
line=list(color=clr, width=2.5),
hovertemplate=paste0("<b>",s,"</b><br>%{x}<br>相对强弱: %{y:.2f}%<extra></extra>"))
buys <- sd %>% filter(buy_signal)
if (nrow(buys) > 0) {
p <- p %>% add_trace(data=buys, x=~date, y=~relative_return_smooth,
type="scatter", mode="markers", legendgroup=s, showlegend=FALSE,
name=paste0(s," 买"),
marker=list(symbol="triangle-up",size=14,color="#2196F3",line=list(color="white",width=2)),
hovertemplate=paste0("<b>",s," 银行->买入</b><br>%{x}<br>%{y:.2f}%<extra></extra>"))
}
sells <- sd %>% filter(sell_signal)
if (nrow(sells) > 0) {
p <- p %>% add_trace(data=sells, x=~date, y=~relative_return_smooth,
type="scatter", mode="markers", legendgroup=s, showlegend=FALSE,
name=paste0(s," 卖"),
marker=list(symbol="triangle-down",size=14,color="#FF5722",line=list(color="white",width=2)),
hovertemplate=paste0("<b>",s," 卖出->银行</b><br>%{x}<br>%{y:.2f}%<extra></extra>"))
}
}
kd <- data %>% filter(name == kline_sector)
if (nrow(kd) > 0) {
p <- p %>% add_trace(data=kd, x=~date,
open=~open, high=~high, low=~low, close=~close,
type="candlestick",
name=paste0(kline_sector," K线"),
increasing=list(line=list(color="#E41A1C"),fillcolor="#E41A1C"),
decreasing=list(line=list(color="#4DAF4A"),fillcolor="#4DAF4A"),
yaxis="y2")
}
pt <- switch(input$period,"day"="日线","2day"="2日","3day"="3日","week"="周线")
mt <- ifelse(input$relative_mode=="cumulative","累计",paste0("滚动",input$rolling_window,"期"))
wt <- anchor_weights()
at <- paste0("锚定:银行",round(wt[1]*100),"%/红利",round(wt[2]*100),"%/高息",round(wt[3]*100),"%")
p %>% layout(
title=list(text=paste0(pt,"-",mt," | ",at), font=list(size=13)),
xaxis=list(title="", rangeslider=list(visible=FALSE)),
yaxis=list(title="相对收益(%)", zeroline=TRUE, side="left"),
yaxis2=list(title=paste0(kline_sector," 价格"),
overlaying="y", side="right", showgrid=FALSE),
legend=list(orientation="h",y=-0.15,x=0.5,xanchor="center"),
hovermode="closest")
})
output$volume_plot <- renderPlotly({
req(signal_data())
kd <- signal_data() %>% filter(name == input$kline_sector)
if (nrow(kd) == 0) return(plotly_empty())
vc <- ifelse(kd$pct_change >= 0, "#E41A1C", "#4DAF4A")
plot_ly(data=kd, x=~date, y=~volume, type="bar",
marker=list(color=vc), name="成交量", showlegend=FALSE,
hovertemplate="%{x}<br>成交量: %{y:,.0f}<extra></extra>") %>%
layout(xaxis=list(title=""), yaxis=list(title="成交量",tickformat=",.0f"),
margin=list(t=10,b=30))
})
output$signal_table <- renderTable({
req(signal_data())
sd <- signal_data() %>% filter(name %in% input$sectors)
if (nrow(sd) == 0) return(data.frame())
sd %>% group_by(name) %>% summarise(
最新日期 = as.character(max(date)),
当前值 = round(last(relative_return_smooth), 2),
趋势 = ifelse(!is.na(last(slope)) & last(slope) > 0, "\u2191 上升", "\u2193 下降"),
状态 = case_when(
last(relative_return_smooth) < last(buy_threshold_val) ~ "\U0001F7E2 超卖",
last(relative_return_smooth) > last(sell_threshold_val) ~ "\U0001F534 超买",
TRUE ~ "\u26AA 中性"),
.groups = "drop") %>% rename(板块 = name)
})
output$signal_stats <- renderTable({
req(signal_data())
signal_data() %>% filter(name %in% input$sectors) %>%
group_by(name) %>%
summarise(
买入信号 = sum(buy_signal, na.rm = TRUE),
卖出信号 = sum(sell_signal, na.rm = TRUE),
冷却过滤 = sum(buy_raw & !buy_signal, na.rm = TRUE) + sum(sell_raw & !sell_signal, na.rm = TRUE),
.groups = "drop") %>% rename(板块 = name)
})
# ===========================================================
# 板块排名
# ===========================================================
output$ranking_chart <- renderPlotly({
req(signal_data())
d <- signal_data()
if (nrow(d) == 0) return(plotly_empty())
if (input$threshold_mode == "fixed") {
bt <- input$buy_threshold; st <- input$sell_threshold
} else {
bt <- median(d$buy_threshold_val, na.rm = TRUE)
st <- median(d$sell_threshold_val, na.rm = TRUE)
}
ranking <- d %>% group_by(name) %>%
summarise(value = round(last(relative_return_smooth), 2), .groups = "drop") %>%
arrange(value) %>%
mutate(color = case_when(value < bt ~ "#4DAF4A", value > st ~ "#E41A1C", TRUE ~ "#999999"))
plot_ly(ranking, x = ~reorder(name, value), y = ~value, type = "bar",
marker = list(color = ~color),
text = ~paste0(value, "%"), textposition = "outside",
hovertemplate = "<b>%{x}</b><br>%{y:.2f}%<extra></extra>") %>%
layout(title = "板块相对强弱排名", xaxis = list(title = ""),
yaxis = list(title = "相对强弱(%)"),
shapes = list(
list(type="line",x0=-0.5,x1=nrow(ranking)-0.5,y0=bt,y1=bt,
line=list(color="#4ECDC4",width=1,dash="dot")),
list(type="line",x0=-0.5,x1=nrow(ranking)-0.5,y0=st,y1=st,
line=list(color="#FF6B6B",width=1,dash="dot"))))
})
output$ranking_table <- renderTable({
req(signal_data())
d <- signal_data()
if (nrow(d) == 0) return(data.frame())
d %>% group_by(name) %>% summarise(
相对强弱 = round(last(relative_return_smooth), 2),
趋势 = ifelse(!is.na(last(slope)) & last(slope) > 0, "\u2191", "\u2193"),
区域 = case_when(
last(relative_return_smooth) < last(buy_threshold_val) ~ "\U0001F7E2超卖",
last(relative_return_smooth) > last(sell_threshold_val) ~ "\U0001F534超买",
TRUE ~ "\u26AA中性"),
最新涨跌 = paste0(round(last(pct_change), 2), "%"),
最新价格 = round(last(close), 2),
.groups = "drop") %>% arrange(相对强弱) %>% rename(板块 = name)
}, digits = 2)
# ===========================================================
# 锚定组合
# ===========================================================
output$anchor_chart <- renderPlotly({
req(data_store$anchor_data)
wts <- anchor_weights()
anchor_colors <- c("中证银行"="#E41A1C","中证红利"="#377EB8","高股息"="#4DAF4A","锚定组合"="#000000")
comp_list <- lapply(seq_along(data_store$anchor_data), function(i) {
d <- data_store$anchor_data[[i]]
d_agg <- aggregate_to_period(d, input$period)
ret <- calc_daily_return(d_agg) %>%
filter(date >= input$date_range[1], date <= input$date_range[2])
if (nrow(ret) == 0) return(NULL)
ret %>% mutate(cumret = (cumprod(1 + pct_change/100) - 1) * 100) %>%
select(date, name, cumret)
})
comp_df <- bind_rows(comp_list)
ar <- calc_anchor_return(data_store$anchor_data, input$period, wts) %>%
filter(date >= input$date_range[1], date <= input$date_range[2])
if (nrow(ar) > 0) {
ar <- ar %>% mutate(cumret = (cumprod(1 + anchor_return/100) - 1) * 100, name = "锚定组合")
}
p <- plot_ly()
if (nrow(ar) > 0) {
p <- p %>% add_trace(data=ar, x=~date, y=~cumret, type="scatter", mode="lines",
name="锚定组合", line=list(color="#000000",width=3))
}
for (nm in unique(comp_df$name)) {
cd <- comp_df %>% filter(name == nm)
idx <- which(names(data_store$anchor_data) == nm)
lbl <- paste0(nm, " (", round(wts[idx]*100), "%)")
p <- p %>% add_trace(data=cd, x=~date, y=~cumret, type="scatter", mode="lines",
name=lbl, line=list(color=anchor_colors[nm], width=1.5, dash="dash"))
}
p %>% layout(title="锚定组合累计收益", xaxis=list(title=""), yaxis=list(title="累计收益(%)"))
})
output$anchor_stats_table <- renderTable({
req(data_store$anchor_data)
wts <- anchor_weights()
stats <- lapply(seq_along(data_store$anchor_data), function(i) {
d <- data_store$anchor_data[[i]]
d_agg <- aggregate_to_period(d, input$period)
ret <- calc_daily_return(d_agg) %>%
filter(date >= input$date_range[1], date <= input$date_range[2])
if (nrow(ret) == 0) return(NULL)
tr <- (prod(1 + ret$pct_change/100) - 1) * 100
ar <- ((1 + tr/100)^(252/max(nrow(ret),1)) - 1) * 100
vol <- sd(ret$pct_change, na.rm = TRUE) * sqrt(252)
data.frame(
成分 = d$name[1], 权重 = paste0(round(wts[i]*100),"%"),
累计收益 = paste0(round(tr,2),"%"), 年化收益 = paste0(round(ar,2),"%"),
年化波动 = paste0(round(vol,2),"%"), stringsAsFactors = FALSE)
})
bind_rows(stats)
})
# ===========================================================
# 回测净值
# ===========================================================
output$nav_plot <- renderPlotly({
req(backtest_results())
res <- backtest_results()
if (is.null(res[["__global__"]])) return(plotly_empty() %>% layout(title="暂无交易数据"))
nh <- res[["__global__"]]$nav_history
init_cap <- res[["__global__"]]$initial_capital
if (is.null(nh) || nrow(nh) == 0) return(plotly_empty() %>% layout(title="净值数据为空，请检查银行数据是否加载"))
p <- plot_ly()
p <- p %>% add_trace(data=nh, x=~date, y=~nav,
type="scatter", mode="lines", name="组合净值",
line=list(color="#1a237e", width=2.5),
hovertemplate="日期: %{x}<br>净值: %{y:,.0f}<br>银行市值: %{customdata[0]:,.0f}<br>板块市值: %{customdata[1]:,.0f}<extra></extra>",
customdata=~cbind(bank_value, market_value))
p <- p %>% add_trace(x=range(nh$date), y=c(init_cap, init_cap),
type="scatter", mode="lines", name=paste0("初始本金(",format(init_cap,big.mark=","),")"),
line=list(color="gray", width=1.5, dash="dash"))
p %>% layout(
title=paste0("策略净值曲线（初始本金: ", format(init_cap,big.mark=","), " | 空闲资金持有中证银行）"),
xaxis=list(title=""),
yaxis=list(title="净值(元)", tickformat=",.0f"))
})
output$global_stats_table <- renderTable({
req(backtest_results())
stats <- calc_backtest_stats(backtest_results())
stats$global
})
output$sector_stats_table <- renderTable({
req(backtest_results())
stats <- calc_backtest_stats(backtest_results())
stats$sectors
})
output$skip_table <- DT::renderDataTable({
req(backtest_results())
res <- backtest_results()
skip <- res[["__global__"]]$skip_log
if (is.null(skip) || nrow(skip) == 0) return(data.frame(提示="所有信号均已执行"))
skip %>% mutate(日期=as.character(date)) %>% select(日期, 板块=name, 原因=reason)
}, options=list(pageLength=10,scrollX=TRUE), rownames=FALSE)
# ===========================================================
# 交易记录
# ===========================================================
output$trade_table <- DT::renderDataTable({
req(backtest_results())
res <- backtest_results()
s <- input$trade_sector
if (!s %in% names(res)) return(data.frame(提示="暂无数据"))
tr <- res[[s]]$trades
if (is.null(tr) || nrow(tr) == 0) return(data.frame(提示="暂无交易"))
tr %>% mutate(日期=as.character(date)) %>%
select(日期, 操作=action, 价格=price, 金额=amount,
持仓=total_position, 银行市值=bank_value_after,
相对值=relative_value)
}, options=list(pageLength=20,scrollX=TRUE), rownames=FALSE)
output$matched_table <- DT::renderDataTable({
req(backtest_results())
res <- backtest_results()
s <- input$trade_sector
if (!s %in% names(res)) return(data.frame(提示="暂无数据"))
mt <- res[[s]]$matched_trades
if (is.null(mt) || nrow(mt) == 0) return(data.frame(提示="暂无配对交易"))
mt %>% mutate(买入日期=as.character(buy_date), 卖出日期=as.character(sell_date)) %>%
select(买入日期, 卖出日期, 买入价=buy_price, 卖出价=sell_price,
数量=shares, 盈亏=pnl_net,
收益率=return_pct, 持仓天数=holding_days)
}, options=list(pageLength=20,scrollX=TRUE), rownames=FALSE)
# ===========================================================
# 数据诊断
# ===========================================================
output$diag_table <- renderTable({
req(data_store$observe_data)
bind_rows(lapply(names(data_store$observe_data), function(nm) {
d <- data_store$observe_data[[nm]]
data.frame(板块=nm, 记录数=nrow(d),
起始=as.character(min(d$date)), 结束=as.character(max(d$date)),
最新价=round(tail(d$close,1),2),
最低=round(min(d$close),2), 最高=round(max(d$close),2))
}))
})
output$price_plot <- renderPlotly({
req(data_store$observe_data)
all_p <- bind_rows(lapply(data_store$observe_data, function(d)
data.frame(date=d$date, close=d$close, name=d$name[1]))) %>%
filter(name %in% input$sectors,
date >= input$date_range[1], date <= input$date_range[2]) %>%
group_by(name) %>%
mutate(normalized = close / first(close) * 100) %>% ungroup()
if (nrow(all_p) == 0) return(plotly_empty())
plot_ly(all_p, x=~date, y=~normalized, color=~name,
type="scatter", mode="lines") %>%
layout(title="价格走势（归一化=100）",
yaxis=list(title="归一化价格"), xaxis=list(title=""))
})
}
shinyApp(ui = ui, server = server)
